{
  "name": "pi-rules",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "prepare": "node .husky/install.mjs",
    "test": "node --test tests/*.test.ts tests/contract/*.test.ts",
    "test:contract": "node --test tests/contract/*.test.ts",
    "test:unit": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" tests/*.test.ts tests/contract/*.test.ts"
  },
  "dependencies": {
    "front-matter": "4.0.2",
    "picomatch": "4.0.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.19.2",
    "@types/picomatch": "4.0.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.92.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
